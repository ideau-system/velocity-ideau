# Variáveis do servidor do jogo. Nenhuma é obrigatória: sem elas, o jogo sobe
# com tudo na memória e as contas do projeto do Supabase do jogo.

# Banco de perfis, tempos, ranqueada e estatísticas. Em produção, o do
# Supabase, pelo pooler em modo sessão, com o papel corrida_servidor:
# postgresql://corrida_servidor.<projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Projeto do Supabase cujas contas o servidor aceita.
SUPABASE_URL=

# 1 aceita as contas dos pilotos virtuais (npm run piloto -- --ranqueada).
# Só na própria máquina: nunca em produção.
CONTAS_DE_TESTE=

# Na build do site: projeto e chave publicável das contas.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
